metaxtract_source(xz)
metaxtract_source(bzip2)
metaxtract_source(libarchive)

function(metaxtract_archive)
  set(BUILD_SHARED_LIBS OFF)
  set(BUILD_TESTING OFF)
  foreach(option IN ITEMS XZ_NLS XZ_TOOL_XZ XZ_TOOL_XZDEC XZ_TOOL_LZMADEC
      XZ_TOOL_LZMAINFO XZ_TOOL_SCRIPTS XZ_DOC XZ_DOXYGEN)
    set(${option} OFF CACHE BOOL "Library-only reviewed XZ build" FORCE)
  endforeach()
  set(XZ_THREADS no CACHE STRING "Deterministic single-thread decoder" FORCE)
  add_subdirectory("${xz_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/xz")
  set(bzip_sources blocksort.c huffman.c crctable.c randtable.c compress.c decompress.c bzlib.c)
  list(TRANSFORM bzip_sources PREPEND "${bzip2_SOURCE_DIR}/")
  add_library(mx_bzip2 STATIC ${bzip_sources})
  target_include_directories(mx_bzip2 PUBLIC "${bzip2_SOURCE_DIR}")
  foreach(option IN ITEMS ENABLE_MBEDTLS ENABLE_NETTLE ENABLE_OPENSSL ENABLE_LIBB2
      ENABLE_LZ4 ENABLE_LZO ENABLE_LZMA ENABLE_ZSTD ENABLE_ZLIB ENABLE_BZip2
      ENABLE_LIBXML2 ENABLE_EXPAT ENABLE_WIN32_XMLLITE ENABLE_PCREPOSIX ENABLE_PCRE2POSIX
      ENABLE_LIBGCC ENABLE_CNG ENABLE_TAR ENABLE_CPIO ENABLE_CAT ENABLE_UNZIP ENABLE_XATTR
      ENABLE_ACL ENABLE_ICONV ENABLE_TEST ENABLE_INSTALL ENABLE_WERROR)
    set(${option} OFF CACHE BOOL "No implicit libraries, programs, or upstream tests" FORCE)
  endforeach()
  set(MSVC_USE_STATIC_CRT ${METAXTRACT_STATIC_CRT} CACHE BOOL "Match Rust CRT" FORCE)
  set(POSIX_REGEX_LIB NONE CACHE STRING "Archive readers do not require regex" FORCE)
  add_subdirectory("${libarchive_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/archive")
  target_compile_definitions(archive_static PRIVATE HAVE_LIBZ=1 HAVE_ZLIB_H=1
    HAVE_LIBBZ2=1 HAVE_BZLIB_H=1 HAVE_LIBLZMA=1 HAVE_LZMA_H=1 LZMA_API_STATIC)
  target_compile_definitions(archive_static INTERFACE LIBARCHIVE_STATIC)
  target_include_directories(archive_static SYSTEM PRIVATE "${zlib_SOURCE_DIR}"
    "${bzip2_SOURCE_DIR}" "${xz_SOURCE_DIR}/src/liblzma/api")
  target_link_libraries(archive_static PRIVATE mx_zlib mx_bzip2 liblzma)
  if(WIN32)
    # Utility objects reference the CNG RNG even with archive decryption disabled.
    target_link_libraries(archive_static PUBLIC bcrypt)
  endif()
  set_target_properties(archive_static PROPERTIES OUTPUT_NAME mx_archive)
  set_target_properties(liblzma PROPERTIES OUTPUT_NAME mx_lzma)
  set(hook "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/src/archive_alloc.h")
  # Include the platform configuration before intercepting C allocation calls.
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/archive-budget.h"
    "#include \"archive_platform.h\"\n#include \"${hook}\"\n")
  foreach(target IN ITEMS archive_static liblzma mx_bzip2)
    set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
    if(target STREQUAL "archive_static")
      set(header "${CMAKE_CURRENT_BINARY_DIR}/archive-budget.h")
    else()
      set(header "${hook}")
    endif()
    if(MSVC)
      target_compile_options(${target} PRIVATE "/FI${header}")
    else()
      target_compile_options(${target} PRIVATE -include "${header}")
    endif()
    if(METAXTRACT_SANITIZERS)
      target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    endif()
  endforeach()
  install(TARGETS archive_static liblzma mx_bzip2 ARCHIVE DESTINATION lib)
  install(FILES "${libarchive_SOURCE_DIR}/COPYING" DESTINATION share/metaxtract/licenses RENAME libarchive.txt)
  install(FILES "${xz_SOURCE_DIR}/COPYING.0BSD" DESTINATION share/metaxtract/licenses RENAME liblzma.txt)
  install(FILES "${bzip2_SOURCE_DIR}/LICENSE" DESTINATION share/metaxtract/licenses RENAME bzip2.txt)
endfunction()
metaxtract_archive()
