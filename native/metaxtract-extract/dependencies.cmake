metaxtract_source(TagLib)
function(metaxtract_taglib)
  set(BUILD_SHARED_LIBS ON CACHE BOOL "Build reviewed shared libraries" FORCE)
  set(BUILD_BINDINGS OFF CACHE BOOL "No TagLib bindings" FORCE)
  set(BUILD_EXAMPLES OFF CACHE BOOL "No TagLib example programs" FORCE)
  set(BUILD_TESTING OFF)
  set(ENABLE_STATIC_RUNTIME ${METAXTRACT_STATIC_CRT} CACHE BOOL "Match Rust CRT" FORCE)
  set(CMAKE_INSTALL_BINDIR lib)
  set(CMAKE_INSTALL_LIBDIR lib)
  set(CMAKE_DISABLE_FIND_PACKAGE_utf8cpp TRUE)
  set(utf8cpp_INCLUDE_DIR "${utfcpp_SOURCE_DIR}/source" CACHE PATH "Reviewed UTFcpp" FORCE)
  set(ZLIB_INCLUDE_DIR "${zlib_SOURCE_DIR}" CACHE PATH "Reviewed zlib" FORCE)
  set(ZLIB_LIBRARY mx_zlib CACHE STRING "Reviewed zlib target" FORCE)
  if(NOT TARGET ZLIB::ZLIB)
    add_library(ZLIB::ZLIB ALIAS mx_zlib)
  endif()
  add_subdirectory("${TagLib_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/taglib")
  get_directory_property(tag_headers DIRECTORY "${TagLib_SOURCE_DIR}/taglib" INCLUDE_DIRECTORIES)
  foreach(directory IN LISTS tag_headers)
    target_include_directories(tag SYSTEM INTERFACE "$<BUILD_INTERFACE:${directory}>")
  endforeach()
  target_include_directories(tag SYSTEM INTERFACE "$<BUILD_INTERFACE:${TagLib_SOURCE_DIR}/taglib>")
  set_target_properties(tag PROPERTIES INSTALL_NAME_DIR "@rpath")
  if(METAXTRACT_SANITIZERS)
    target_compile_options(tag PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(tag PRIVATE -fsanitize=address,undefined)
  endif()
endfunction()
metaxtract_taglib()
install(FILES "${TagLib_SOURCE_DIR}/COPYING.LGPL" "${TagLib_SOURCE_DIR}/COPYING.MPL"
  DESTINATION share/metaxtract/licenses)
install(FILES "${utfcpp_SOURCE_DIR}/LICENSE" DESTINATION share/metaxtract/licenses RENAME utfcpp.txt)

