include(FetchContent)

function(metaxtract_verify_source name directory revision)
  find_package(Git REQUIRED QUIET)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}" rev-parse HEAD
    OUTPUT_VARIABLE actual_revision OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE revision_status ERROR_QUIET)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}" diff --no-ext-diff --quiet HEAD --
    RESULT_VARIABLE change_status ERROR_QUIET)
  if(NOT revision_status EQUAL 0 OR NOT actual_revision STREQUAL revision OR NOT change_status EQUAL 0)
    message(FATAL_ERROR "Cached ${name} source differs from reviewed commit ${revision}: ${directory}")
  endif()
endfunction()

function(metaxtract_source name)
  file(READ "${PROJECT_SOURCE_DIR}/third-party.lock.toml" dependency_lock)
  string(REGEX MATCH "name = \"${name}\"[^\[]*" entry "${dependency_lock}")
  foreach(field IN ITEMS revision source)
    string(REGEX MATCH "${field} = \"([^\"]+)\"" match "${entry}")
    if(NOT match)
      message(FATAL_ERROR "Missing reviewed ${field} for ${name}")
    endif()
    set(${field} "${CMAKE_MATCH_1}")
  endforeach()
  string(TOLOWER "${name}" id)
  string(TOUPPER "${id}" upper_id)
  set(source_options)
  if(NOT FETCHCONTENT_SOURCE_DIR_${upper_id})
    set(cache_root "${PROJECT_SOURCE_DIR}/target/native-sources")
    set(cached_source "${cache_root}/${id}-${revision}")
    file(MAKE_DIRECTORY "${cache_root}")
    file(LOCK "${cached_source}.lock" GUARD FUNCTION TIMEOUT 120 RESULT_VARIABLE lock_status)
    if(NOT lock_status STREQUAL "0")
      message(FATAL_ERROR "Could not lock ${name} source cache: ${lock_status}")
    endif()
    if(EXISTS "${cached_source}/.git")
      metaxtract_verify_source("${name}" "${cached_source}" "${revision}")
      set(FETCHCONTENT_SOURCE_DIR_${upper_id} "${cached_source}")
    endif()
    set(source_options SOURCE_DIR "${cached_source}")
  endif()
  FetchContent_Declare(${id}
    GIT_REPOSITORY "${source}" GIT_TAG "${revision}"
    GIT_SUBMODULES ""
    ${source_options}
    SOURCE_SUBDIR _metaxtract_sources_only)
  FetchContent_MakeAvailable(${id})
  if(cached_source)
    metaxtract_verify_source("${name}" "${cached_source}" "${revision}")
  endif()
  set(${name}_SOURCE_DIR "${${id}_SOURCE_DIR}" PARENT_SCOPE)
  set(${name}_REVISION "${revision}" PARENT_SCOPE)
endfunction()

metaxtract_source(pugixml)
add_library(mx_pugixml STATIC "${pugixml_SOURCE_DIR}/src/pugixml.cpp")
target_include_directories(mx_pugixml PUBLIC "${pugixml_SOURCE_DIR}/src")

metaxtract_source(zlib)
set(zlib_sources adler32.c crc32.c deflate.c infback.c inffast.c inflate.c
  inftrees.c trees.c uncompr.c compress.c zutil.c)
list(TRANSFORM zlib_sources PREPEND "${zlib_SOURCE_DIR}/")
add_library(mx_zlib STATIC ${zlib_sources})
set_target_properties(mx_zlib PROPERTIES C_VISIBILITY_PRESET hidden)
target_include_directories(mx_zlib PUBLIC "${zlib_SOURCE_DIR}")

foreach(target IN ITEMS mx_pugixml mx_zlib)
  set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
  if(METAXTRACT_SANITIZERS)
    target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
  endif()
endforeach()
install(TARGETS mx_pugixml mx_zlib ARCHIVE DESTINATION lib)
install(FILES "${pugixml_SOURCE_DIR}/LICENSE.md" DESTINATION share/metaxtract/licenses RENAME pugixml.txt)
install(FILES "${zlib_SOURCE_DIR}/LICENSE" DESTINATION share/metaxtract/licenses RENAME zlib.txt)

metaxtract_source(LibRaw)
file(GLOB_RECURSE libraw_sources CONFIGURE_DEPENDS "${LibRaw_SOURCE_DIR}/src/*.cpp")
list(FILTER libraw_sources EXCLUDE REGEX "_ph\\.cpp$")
add_library(mx_libraw SHARED ${libraw_sources})
target_include_directories(mx_libraw SYSTEM PUBLIC "${LibRaw_SOURCE_DIR}")
target_compile_features(mx_libraw PRIVATE cxx_std_17)
target_compile_definitions(mx_libraw PRIVATE LIBRAW_BUILDLIB)
if(WIN32)
  target_compile_definitions(mx_libraw PUBLIC NOMINMAX)
  target_link_libraries(mx_libraw PRIVATE ws2_32)
endif()
set_target_properties(mx_libraw PROPERTIES POSITION_INDEPENDENT_CODE ON
  INSTALL_NAME_DIR "@rpath")
if(METAXTRACT_SANITIZERS)
  target_compile_options(mx_libraw PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
  target_link_options(mx_libraw PRIVATE -fsanitize=address,undefined)
endif()
install(TARGETS mx_libraw ARCHIVE DESTINATION lib LIBRARY DESTINATION lib RUNTIME DESTINATION lib)
install(FILES "${LibRaw_SOURCE_DIR}/LICENSE.LGPL" "${LibRaw_SOURCE_DIR}/LICENSE.CDDL"
  "${LibRaw_SOURCE_DIR}/COPYRIGHT" DESTINATION share/metaxtract/licenses)

