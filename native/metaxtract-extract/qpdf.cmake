metaxtract_source(libjpeg-turbo)
include(ExternalProject)
set(jpeg_prefix "${CMAKE_CURRENT_BINARY_DIR}/jpeg-install")
file(MAKE_DIRECTORY "${jpeg_prefix}/include")
set(jpeg_cflags "${CMAKE_C_FLAGS}")
if(METAXTRACT_SANITIZERS)
  string(APPEND jpeg_cflags " -fsanitize=address,undefined -fno-omit-frame-pointer")
endif()
if(CMAKE_MSVC_RUNTIME_LIBRARY)
  set(jpeg_crt "${CMAKE_MSVC_RUNTIME_LIBRARY}")
elseif(METAXTRACT_STATIC_CRT)
  set(jpeg_crt "MultiThreaded$<$<CONFIG:Debug>:Debug>")
else()
  set(jpeg_crt "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
endif()
if(MSVC)
  set(jpeg_archive "${jpeg_prefix}/lib/jpeg-static.lib")
else()
  set(jpeg_archive "${jpeg_prefix}/lib/libjpeg.a")
endif()
ExternalProject_Add(mx_jpeg_build
  SOURCE_DIR "${libjpeg-turbo_SOURCE_DIR}"
  BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}/jpeg-build"
  INSTALL_DIR "${jpeg_prefix}"
  CMAKE_ARGS
    "-DCMAKE_INSTALL_PREFIX=<INSTALL_DIR>" "-DCMAKE_INSTALL_LIBDIR=lib"
    "-DCMAKE_BUILD_TYPE=Release" "-DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}"
    "-DCMAKE_C_FLAGS=${jpeg_cflags}" "-DCMAKE_MSVC_RUNTIME_LIBRARY=${jpeg_crt}"
    "-DCMAKE_POSITION_INDEPENDENT_CODE=ON" "-DENABLE_SHARED=OFF"
    "-DENABLE_STATIC=ON" "-DWITH_SIMD=OFF" "-DWITH_TURBOJPEG=OFF"
    "-DWITH_CRT_DLL=ON"
    "-DWITH_TOOLS=OFF" "-DWITH_TESTS=OFF"
  BUILD_BYPRODUCTS "${jpeg_archive}")
add_library(mx_jpeg STATIC IMPORTED GLOBAL)
set_target_properties(mx_jpeg PROPERTIES IMPORTED_LOCATION "${jpeg_archive}"
  INTERFACE_INCLUDE_DIRECTORIES "${jpeg_prefix}/include")
add_dependencies(mx_jpeg mx_jpeg_build)

metaxtract_source(qpdf)
function(metaxtract_qpdf)
  # Reuse the locked upstream source/crypto lists, without its CLI, tests,
  # package detection or implicit OpenSSL/GnuTLS/system-library selection.
  file(READ "${qpdf_SOURCE_DIR}/libqpdf/CMakeLists.txt" qpdf_manifest)
  set(qpdf_sources)
  foreach(block IN ITEMS libqpdf_SOURCES libqpdf_crypto_native)
    string(REGEX MATCH "set\\(${block}([^)]*)\\)" source_block "${qpdf_manifest}")
    if(NOT source_block)
      message(FATAL_ERROR "Reviewed qpdf source list missing: ${block}")
    endif()
    string(REGEX MATCHALL "[A-Za-z0-9_-]+\\.(cc|c)" block_sources "${source_block}")
    list(APPEND qpdf_sources ${block_sources})
  endforeach()
  list(TRANSFORM qpdf_sources PREPEND "${qpdf_SOURCE_DIR}/libqpdf/")
  include(CheckIncludeFile)
  include(CheckSymbolExists)
  include(CheckStructHasMember)
  include(CheckTypeSize)
  check_type_size(size_t SIZEOF_SIZE_T)
  check_include_file(inttypes.h HAVE_INTTYPES_H)
  check_include_file(stdint.h HAVE_STDINT_H)
  check_symbol_exists(localtime_r "time.h" HAVE_LOCALTIME_R)
  check_symbol_exists(fseeko "stdio.h" HAVE_FSEEKO)
  check_symbol_exists(fseeko64 "stdio.h" HAVE_FSEEKO64)
  check_symbol_exists(random "stdlib.h" HAVE_RANDOM)
  check_symbol_exists(timezone "time.h" HAVE_EXTERN_LONG_TIMEZONE)
  check_struct_has_member("struct tm" tm_gmtoff "time.h" HAVE_TM_GMTOFF)
  if(NOT WIN32)
    check_symbol_exists(malloc_info "malloc.h" HAVE_MALLOC_INFO)
    check_symbol_exists(open_memstream "stdio.h" HAVE_OPEN_MEMSTREAM)
    set(_FILE_OFFSET_BITS 64)
  endif()
  set(USE_CRYPTO_NATIVE ON)
  set(DEFAULT_CRYPTO native)
  set(USE_CRYPTO_OPENSSL OFF)
  set(USE_CRYPTO_GNUTLS OFF)
  set(ZOPFLI OFF)
  set(USE_INSECURE_RANDOM OFF)
  set(SKIP_OS_SECURE_RANDOM OFF)
  set(qpdf_generated "${CMAKE_CURRENT_BINARY_DIR}/qpdf-generated")
  configure_file("${qpdf_SOURCE_DIR}/libqpdf/qpdf/qpdf-config.h.in"
    "${qpdf_generated}/qpdf/qpdf-config.h" NEWLINE_STYLE UNIX)
  file(READ "${qpdf_SOURCE_DIR}/libqpdf/Pl_Buffer.cc" qpdf_buffer)
  string(FIND "${qpdf_buffer}" "    m->data.append(" qpdf_buffer_anchor)
  if(qpdf_buffer_anchor LESS 0)
    message(FATAL_ERROR "Reviewed QPDF buffer budget insertion point is missing")
  endif()
  string(REPLACE "    m->data.append("
    "    metaxtract_qpdf_buffer_charge(len);\n    m->data.append(" qpdf_buffer "${qpdf_buffer}")
  set(qpdf_buffer "// MetaXtract modification: parser-local allocation and decoded-byte budget checks.\n// Original QPDF source is covered by the bundled Apache-2.0 LICENSE and NOTICE.\n#include <cstddef>\nextern \"C\" void metaxtract_qpdf_buffer_charge(std::size_t);\n${qpdf_buffer}")
  metaxtract_write_generated("${qpdf_generated}/Pl_Buffer.cc" "${qpdf_buffer}")
  list(REMOVE_ITEM qpdf_sources "${qpdf_SOURCE_DIR}/libqpdf/Pl_Buffer.cc")
  list(APPEND qpdf_sources "${qpdf_generated}/Pl_Buffer.cc")
  foreach(file IN ITEMS Pl_String.cc QPDF.cc)
    file(READ "${qpdf_SOURCE_DIR}/libqpdf/${file}" modified)
    if(file STREQUAL "Pl_String.cc")
      set(anchor "    m->s.append(")
      set(replacement "    metaxtract_qpdf_buffer_charge(len);\n    m->s.append(")
    else()
      set(anchor "    m->warnings.emplace_back(e);")
      set(replacement "    metaxtract_qpdf_warning_charge(e.getMessageDetail().size());\n    m->warnings.emplace_back(e);")
    endif()
    string(FIND "${modified}" "${anchor}" insertion)
    if(insertion LESS 0)
      message(FATAL_ERROR "Reviewed QPDF budget insertion point missing: ${file}")
    endif()
    string(REPLACE "${anchor}" "${replacement}" modified "${modified}")
    metaxtract_write_generated("${qpdf_generated}/${file}"
      "// MetaXtract modification: bounded retained strings and warnings.\n// Original QPDF source is covered by the bundled Apache-2.0 LICENSE and NOTICE.\n#include <cstddef>\nextern \"C\" void metaxtract_qpdf_buffer_charge(std::size_t);\nextern \"C\" void metaxtract_qpdf_warning_charge(std::size_t);\n${modified}")
    list(REMOVE_ITEM qpdf_sources "${qpdf_SOURCE_DIR}/libqpdf/${file}")
    list(APPEND qpdf_sources "${qpdf_generated}/${file}")
  endforeach()
  file(READ "${qpdf_SOURCE_DIR}/libqpdf/qpdf/Pipeline_private.hh" private_pipeline)
  set(string_anchor "                str.append(reinterpret_cast<char const*>(buf), len);")
  string(FIND "${private_pipeline}" "${string_anchor}" string_insertion)
  if(string_insertion LESS 0)
    message(FATAL_ERROR "Reviewed QPDF internal string budget insertion point missing")
  endif()
  string(REPLACE "${string_anchor}"
    "                metaxtract_qpdf_buffer_charge(len);\n${string_anchor}" private_pipeline "${private_pipeline}")
  metaxtract_write_generated("${qpdf_generated}/qpdf/Pipeline_private.hh"
    "// MetaXtract modification: bound decoded object/xref-stream strings.\n// Original QPDF source is covered by the bundled Apache-2.0 LICENSE and NOTICE.\n#include <cstddef>\nextern \"C\" void metaxtract_qpdf_buffer_charge(std::size_t);\n${private_pipeline}")
  add_library(mx_qpdf STATIC ${qpdf_sources})
  add_dependencies(mx_qpdf mx_jpeg_build)
  target_include_directories(mx_qpdf SYSTEM PUBLIC "${qpdf_SOURCE_DIR}/include")
  target_include_directories(mx_qpdf PRIVATE "${qpdf_generated}" "${qpdf_SOURCE_DIR}/libqpdf")
  target_compile_features(mx_qpdf PRIVATE cxx_std_20)
  target_compile_definitions(mx_qpdf PRIVATE QPDF_DISABLE_QTC=1)
  target_link_libraries(mx_qpdf PUBLIC mx_zlib mx_jpeg)
  set_target_properties(mx_qpdf PROPERTIES POSITION_INDEPENDENT_CODE ON)
  if(WIN32)
    target_link_libraries(mx_qpdf PUBLIC ws2_32 shell32 advapi32 gdi32 user32 crypt32)
  endif()
  if(METAXTRACT_SANITIZERS)
    target_compile_options(mx_qpdf PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
  endif()
  install(TARGETS mx_qpdf ARCHIVE DESTINATION lib)
endfunction()
metaxtract_qpdf()
install(FILES "${jpeg_archive}" DESTINATION lib
  RENAME "${CMAKE_STATIC_LIBRARY_PREFIX}mx_jpeg${CMAKE_STATIC_LIBRARY_SUFFIX}")
install(FILES "${qpdf_SOURCE_DIR}/LICENSE.txt" "${qpdf_SOURCE_DIR}/NOTICE.md"
  DESTINATION share/metaxtract/licenses)
install(FILES "${libjpeg-turbo_SOURCE_DIR}/LICENSE.md" DESTINATION share/metaxtract/licenses RENAME libjpeg-turbo.txt)
install(FILES "${libjpeg-turbo_SOURCE_DIR}/README.ijg" DESTINATION share/metaxtract/licenses RENAME libjpeg-IJG.txt)
